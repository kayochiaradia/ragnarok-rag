# O modo local não precisa de nenhuma variável.
RAG_EMBEDDING_BACKEND=hash
RAG_STORE_BACKEND=numpy
RAG_WEB_HOST=127.0.0.1
RAG_WEB_PORT=8000

# Meta WhatsApp Cloud API (necessário somente para /webhook/meta).
WHATSAPP_VERIFY_TOKEN=troque-este-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Informe uma versão atualmente suportada no painel/documentação da Meta.
WHATSAPP_API_VERSION=

WHATSAPP_MAX_QUERY_CHARS=500
WHATSAPP_MAX_CHARS=3500
WHATSAPP_RATE_LIMIT=20
